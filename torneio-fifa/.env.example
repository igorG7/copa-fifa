# Connection string do MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/torneio-fifa?retryWrites=true&w=majority

# Nome do banco (opcional, se nao vier na URI)
MONGODB_DB=torneio-fifa

# Senha unica do administrador (quem sorteia grupos e lanca placares)
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessao do admin (qualquer string longa e aleatoria)
SESSION_SECRET=troque-este-segredo-tambem
